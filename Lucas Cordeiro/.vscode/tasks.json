{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Clínica Veterinária: compilar backend",
            "type": "shell",
            "command": "${workspaceFolder}\\backend\\mvnw.cmd",
            "args": [
                "compile"
            ],
            "options": {
                "cwd": "${workspaceFolder}\\backend"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$javac"
        },
        {
            "label": "Clínica Veterinária: testar conexão SQLite",
            "type": "shell",
            "command": "${workspaceFolder}\\backend\\mvnw.cmd",
            "args": [
                "compile",
                "exec:java"
            ],
            "options": {
                "cwd": "${workspaceFolder}\\backend"
            },
            "problemMatcher": []
        }
    ]
}
