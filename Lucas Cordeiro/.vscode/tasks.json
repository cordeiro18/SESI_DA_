{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Clínica Veterinária: compilar backend",
            "type": "shell",
            "command": "${workspaceFolder}\\backend\\mvnw.cmd",
            "args": [
                "compile"
            ],
            "options": {
                "cwd": "${workspaceFolder}\\backend"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$javac"
        },
        {
            "label": "Clínica Veterinária: iniciar site e API",
            "type": "shell",
            "command": "${workspaceFolder}\\backend\\iniciar.cmd",
            "args": [],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
