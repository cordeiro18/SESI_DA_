-- ==========================================
-- SISTEMA DE GESTAO VETERINARIA - VETCARE
-- SCRIPT DE CRIACAO E POPULACAO DO BANCO
-- Banco de dados: SQLite
-- ==========================================

PRAGMA foreign_keys = ON;

-- ==========================================
-- 1. LIMPEZA DAS TABELAS
-- ==========================================

DROP TABLE IF EXISTS agendamentos;
DROP TABLE IF EXISTS pets;
DROP TABLE IF EXISTS tutores;
DROP TABLE IF EXISTS usuarios;

-- ==========================================
-- 2. TABELA DE USUARIOS
-- ==========================================

CREATE TABLE usuarios (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    nome TEXT NOT NULL,
    email TEXT NOT NULL UNIQUE,
    senha_hash TEXT NOT NULL,
    perfil TEXT NOT NULL DEFAULT 'FUNCIONARIO'
        CHECK (perfil IN ('ADMIN', 'FUNCIONARIO')),
    criado_em TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
);

-- ==========================================
-- 3. TABELA DE TUTORES
-- ==========================================

CREATE TABLE tutores (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    nome TEXT NOT NULL,
    cpf_cifrado TEXT UNIQUE,
    telefone TEXT NOT NULL,
    endereco TEXT,
    criado_em TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
);

-- ==========================================
-- 4. TABELA DE PETS
-- ==========================================

CREATE TABLE pets (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    tutor_id INTEGER NOT NULL,
    nome TEXT NOT NULL,
    especie TEXT NOT NULL,
    raca TEXT,
    data_nascimento TEXT,
    sexo TEXT CHECK (sexo IN ('M', 'F', 'NAO INFORMADO')),
    criado_em TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,

    FOREIGN KEY (tutor_id)
        REFERENCES tutores(id)
        ON UPDATE CASCADE
        ON DELETE RESTRICT
);

-- ==========================================
-- 5. TABELA DE AGENDAMENTOS
-- ==========================================

CREATE TABLE agendamentos (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    pet_id INTEGER NOT NULL,
    data TEXT NOT NULL,
    horario TEXT NOT NULL,
    motivo TEXT NOT NULL,
    status TEXT NOT NULL DEFAULT 'AGENDADO'
        CHECK (status IN (
            'AGENDADO',
            'CONFIRMADO',
            'CONCLUIDO',
            'CANCELADO'
        )),
    criado_em TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,

    FOREIGN KEY (pet_id)
        REFERENCES pets(id)
        ON UPDATE CASCADE
        ON DELETE RESTRICT,

    UNIQUE (data, horario, pet_id)
);

-- ==========================================
-- 6. INDICES PARA MELHORAR AS CONSULTAS
-- ==========================================

CREATE INDEX idx_tutores_nome
ON tutores(nome);

CREATE INDEX idx_pets_tutor
ON pets(tutor_id);

CREATE INDEX idx_agendamentos_data
ON agendamentos(data);

CREATE INDEX idx_agendamentos_pet
ON agendamentos(pet_id);

-- ==========================================
