-- ==========================================
-- 11. CONSULTAS PARA CONFERENCIA
-- ==========================================

-- Listar usuarios
SELECT id, nome, email, perfil
FROM usuarios;

-- Listar tutores
SELECT * FROM tutores;

-- Listar pets com seus tutores
SELECT
    pets.id,
    pets.nome AS pet,
    pets.especie,
    pets.raca,
    tutores.nome AS tutor
FROM pets
INNER JOIN tutores
ON pets.tutor_id = tutores.id;

-- Listar agendamentos completos
SELECT
    agendamentos.id,
    pets.nome AS pet,
    tutores.nome AS tutor,
    agendamentos.data,
    agendamentos.horario,
    agendamentos.motivo,
    agendamentos.status
FROM agendamentos
INNER JOIN pets
ON agendamentos.pet_id = pets.id
INNER JOIN tutores
ON pets.tutor_id = tutores.id;

